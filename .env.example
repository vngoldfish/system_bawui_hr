# ==============================================================================
# BAWUI HR System Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and configure it with secure credentials for VPS deployment.
# Note: For local development, default values will be used if a `.env` file is not created.

# Database Credentials
DB_USER=postgres
DB_PASSWORD=your_secure_vps_database_password_here
DB_NAME=hr_db

# Backup Configuration (number of days to keep historical backups)
BACKUP_KEEP_DAYS=7
